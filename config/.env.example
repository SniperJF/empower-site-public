# Copy this file to config/.env and fill in real values.
# The placeholders below are enough to run the site locally.

PORT=8080
ENV_URL=https://localhost:8080

# TLS certificate and key (see "Setting up a TLS Certificate" in README.md)
TLS_CERT_PATH=csr-key/cert.pem
TLS_KEY_PATH=csr-key/key.pem

# SQLite database (SampleData.sqlite contains synthetic data only)
DB_URL=SampleData.sqlite

# Admin dashboard login and session signing secret
ACCESS_TOKEN_SECRET=change-me
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Contact form (Gmail account + app password, and the address messages go to)
EMAILSERVER=from@example.com
EMAILPASS=app-password
EMAILROUTEE=to@example.com

# Third-party API tokens
IPINFO_API_TOKEN=
RECAPTCHA_API_TOKEN=
